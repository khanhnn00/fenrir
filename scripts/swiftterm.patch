+            while let c = url.last, ".,;:!?)]}".contains(c) { url.removeLast() }
+            let end = m.range.location + (url as NSString).length
+            guard offset < end else { return nil }
+            return (url, hit.row, max(m.range.location - rowStart, 0), min(end - rowStart, cols))
+        }
+        return nil
+    }
