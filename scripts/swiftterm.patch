diff --git a/Sources/SwiftTerm/Apple/BoxDrawing.swift b/Sources/SwiftTerm/Apple/BoxDrawing.swift
new file mode 100644
index 0000000..74ad13f
--- /dev/null
+++ b/Sources/SwiftTerm/Apple/BoxDrawing.swift
@@ -0,0 +1,181 @@
+//
+// BoxDrawing.swift
+//
+// Draws box-drawing (U+2500-257F) and block-element (U+2580-259F) cells as pixel-snapped rectangles
+// that span the whole cell, so rules and frames join across cells and rows instead of showing the
+// hairline seams that font glyphs leave at fractional cell edges.
+//
+#if os(macOS)
+import Foundation
+import CoreGraphics
+import AppKit
+
+enum BoxDrawing {
+    /// Cells drawn here are blanked in the attributed string.
+    static func handles(_ code: Int32) -> Bool {
+        (0x2500...0x2570).contains(code) || (0x2574...0x259F).contains(code)
+    }
+
+    /// Stroke weights: 0 none, 1 light, 2 heavy (double lines render heavy).
+    typealias Arms = (l: UInt8, r: UInt8, u: UInt8, d: UInt8)
+
+    static func arms(_ c: Int32) -> Arms? {
+        switch c {
+        case 0x2500, 0x2504, 0x2508, 0x254C: return (1, 1, 0, 0)
+        case 0x2501, 0x2505, 0x2509, 0x254D: return (2, 2, 0, 0)
+        case 0x2502, 0x2506, 0x250A, 0x254E: return (0, 0, 1, 1)
+        case 0x2503, 0x2507, 0x250B, 0x254F: return (0, 0, 2, 2)
+        case 0x250C...0x254B:
+            let i = Int(c - 0x250C)
+            // Corners 250C-2523 and tees 2524-254B follow a fixed weight sequence; compute from the group.
+            return table[i]
+        case 0x2550, 0x2551...0x256C: return double(c)
+        case 0x256D: return (0, 1, 0, 1)
+        case 0x256E: return (1, 0, 0, 1)
+        case 0x256F: return (1, 0, 1, 0)
+        case 0x2570: return (0, 1, 1, 0)
+        case 0x2574: return (1, 0, 0, 0)
+        case 0x2575: return (0, 0, 1, 0)
+        case 0x2576: return (0, 1, 0, 0)
+        case 0x2577: return (0, 0, 0, 1)
+        case 0x2578: return (2, 0, 0, 0)
+        case 0x2579: return (0, 0, 2, 0)
+        case 0x257A: return (0, 2, 0, 0)
+        case 0x257B: return (0, 0, 0, 2)
+        case 0x257C: return (1, 2, 0, 0)
+        case 0x257D: return (0, 0, 1, 2)
+        case 0x257E: return (2, 1, 0, 0)
+        case 0x257F: return (0, 0, 2, 1)
+        default: return nil
+        }
+    }
+
+    // 250C...254B as (l, r, u, d), in code point order.
+    private static let table: [Arms] = [
+        (0,1,0,1), (0,2,0,1), (0,1,0,2), (0,2,0,2),   // 250C-250F  down-right corners
+        (1,0,0,1), (2,0,0,1), (1,0,0,2), (2,0,0,2),   // 2510-2513  down-left
+        (0,1,1,0), (0,2,1,0), (0,1,2,0), (0,2,2,0),   // 2514-2517  up-right
+        (1,0,1,0), (2,0,1,0), (1,0,2,0), (2,0,2,0),   // 2518-251B  up-left
+        (0,1,1,1), (0,2,1,1), (0,1,2,1), (0,1,1,2),   // 251C-251F  vertical + right
+        (0,1,2,2), (0,2,2,1), (0,2,1,2), (0,2,2,2),   // 2520-2523
+        (1,0,1,1), (2,0,1,1), (1,0,2,1), (1,0,1,2),   // 2524-2527  vertical + left
+        (1,0,2,2), (2,0,2,1), (2,0,1,2), (2,0,2,2),   // 2528-252B
+        (1,1,0,1), (2,1,0,1), (1,2,0,1), (2,2,0,1),   // 252C-252F  horizontal + down
+        (1,1,0,2), (2,1,0,2), (1,2,0,2), (2,2,0,2),   // 2530-2533
+        (1,1,1,0), (2,1,1,0), (1,2,1,0), (2,2,1,0),   // 2534-2537  horizontal + up
+        (1,1,2,0), (2,1,2,0), (1,2,2,0), (2,2,2,0),   // 2538-253B
+        (1,1,1,1), (2,1,1,1), (1,2,1,1), (2,2,1,1),   // 253C-253F  cross
+        (1,1,2,1), (1,1,1,2), (1,1,2,2), (2,1,2,1),   // 2540-2543
+        (1,2,2,1), (2,1,1,2), (1,2,1,2), (2,2,2,1),   // 2544-2547
+        (2,2,1,2), (2,1,2,2), (1,2,2,2), (2,2,2,2),   // 2548-254B
+    ]
+
+    private static func double(_ c: Int32) -> Arms? {
+        switch c {
+        case 0x2550: return (2, 2, 0, 0)
+        case 0x2551: return (0, 0, 2, 2)
+        case 0x2552: return (0, 2, 0, 1)
+        case 0x2553: return (0, 1, 0, 2)
+        case 0x2554: return (0, 2, 0, 2)
+        case 0x2555: return (2, 0, 0, 1)
+        case 0x2556: return (1, 0, 0, 2)
+        case 0x2557: return (2, 0, 0, 2)
+        case 0x2558: return (0, 2, 1, 0)
+        case 0x2559: return (0, 1, 2, 0)
+        case 0x255A: return (0, 2, 2, 0)
+        case 0x255B: return (2, 0, 1, 0)
+        case 0x255C: return (1, 0, 2, 0)
+        case 0x255D: return (2, 0, 2, 0)
+        case 0x255E: return (0, 2, 1, 1)
+        case 0x255F: return (0, 1, 2, 2)
+        case 0x2560: return (0, 2, 2, 2)
+        case 0x2561: return (2, 0, 1, 1)
+        case 0x2562: return (1, 0, 2, 2)
+        case 0x2563: return (2, 0, 2, 2)
+        case 0x2564: return (2, 2, 0, 1)
+        case 0x2565: return (1, 1, 0, 2)
+        case 0x2566: return (2, 2, 0, 2)
+        case 0x2567: return (2, 2, 1, 0)
+        case 0x2568: return (1, 1, 2, 0)
+        case 0x2569: return (2, 2, 2, 0)
+        case 0x256A: return (2, 2, 1, 1)
+        case 0x256B: return (1, 1, 2, 2)
+        case 0x256C: return (2, 2, 2, 2)
+        default: return nil
+        }
+    }
+
+    /// Block elements as fractions of the cell: (x0, y0, x1, y1) with y measured from the top, plus alpha.
+    static func blocks(_ c: Int32) -> (rects: [(CGFloat, CGFloat, CGFloat, CGFloat)], alpha: CGFloat)? {
+        func r(_ x0: CGFloat, _ y0: CGFloat, _ x1: CGFloat, _ y1: CGFloat) -> (CGFloat, CGFloat, CGFloat, CGFloat) { (x0, y0, x1, y1) }
+        let ul = r(0, 0, 0.5, 0.5), ur = r(0.5, 0, 1, 0.5), ll = r(0, 0.5, 0.5, 1), lr = r(0.5, 0.5, 1, 1)
+        switch c {
+        case 0x2580: return ([r(0, 0, 1, 0.5)], 1)
+        case 0x2581...0x2588: return ([r(0, 1 - CGFloat(c - 0x2580) / 8, 1, 1)], 1)
+        case 0x2589...0x258F: return ([r(0, 0, CGFloat(0x2590 - c) / 8, 1)], 1)
+        case 0x2590: return ([r(0.5, 0, 1, 1)], 1)
+        case 0x2591: return ([r(0, 0, 1, 1)], 0.25)
+        case 0x2592: return ([r(0, 0, 1, 1)], 0.5)
+        case 0x2593: return ([r(0, 0, 1, 1)], 0.75)
+        case 0x2594: return ([r(0, 0, 1, 0.125)], 1)
+        case 0x2595: return ([r(0.875, 0, 1, 1)], 1)
+        case 0x2596: return ([ll], 1)
+        case 0x2597: return ([lr], 1)
+        case 0x2598: return ([ul], 1)
+        case 0x2599: return ([ul, ll, lr], 1)
+        case 0x259A: return ([ul, lr], 1)
+        case 0x259B: return ([ul, ur, ll], 1)
+        case 0x259C: return ([ul, ur, lr], 1)
+        case 0x259D: return ([ur], 1)
+        case 0x259E: return ([ur, ll], 1)
+        case 0x259F: return ([ur, ll, lr], 1)
+        default: return nil
+        }
+    }
+}
+
+extension TerminalView {
+    /// Paints the box-drawing / block cells of one row. `origin` is the bottom-left corner of the row.
+    func drawBoxCells(line: BufferLine, origin: CGPoint, context: CGContext) {
+        let cw = cellDimension.width, ch = cellDimension.height
+        let scale = max(backingScaleFactor(), 1)
+        func snap(_ v: CGFloat) -> CGFloat { (v * scale).rounded() / scale }
+        let px = 1 / scale
+        let light = max(px, (cw * scale / 8).rounded() * px)
+
+        for col in 0..<terminal.cols {
+            let cd = line[col]
+            guard BoxDrawing.handles(cd.code) else { continue }
+            var fg = cd.attribute.fg, bg = cd.attribute.bg
+            if cd.attribute.style.contains(.inverse) {
+                swap(&fg, &bg)
+                if fg == .defaultColor { fg = .defaultInvertedColor }
+            }
+            let color = mapColor(color: fg, isFg: true, isBold: cd.attribute.style.contains(.bold))
+            let x0 = snap(origin.x + CGFloat(col) * cw), x1 = snap(origin.x + CGFloat(col + 1) * cw)
+            let y0 = snap(origin.y), y1 = snap(origin.y + ch)
+
+            context.saveGState()
+            context.setShouldAntialias(false)
+            context.setFillColor(color.cgColor)
+            if let b = BoxDrawing.blocks(cd.code) {
+                if b.alpha < 1 { context.setAlpha(b.alpha) }
+                for f in b.rects {
+                    context.fill(CGRect(x: snap(x0 + f.0 * (x1 - x0)), y: snap(y1 - f.3 * (y1 - y0)),
+                                        width: snap(x0 + f.2 * (x1 - x0)) - snap(x0 + f.0 * (x1 - x0)),
+                                        height: snap(y1 - f.1 * (y1 - y0)) - snap(y1 - f.3 * (y1 - y0))))
+                }
+            } else if let a = BoxDrawing.arms(cd.code) {
+                let hl = CGFloat(max(a.l, a.r, 1)) * light, vl = CGFloat(max(a.u, a.d, 1)) * light
+                let cx = snap((x0 + x1) / 2 - vl / 2), cy = snap((y0 + y1) / 2 - hl / 2)
+                // Each arm runs from the cell edge to the far side of the crossing stroke.
+                if a.l > 0 { context.fill(CGRect(x: x0, y: snap((y0 + y1) / 2 - CGFloat(a.l) * light / 2), width: cx + vl - x0, height: CGFloat(a.l) * light)) }
+                if a.r > 0 { context.fill(CGRect(x: cx, y: snap((y0 + y1) / 2 - CGFloat(a.r) * light / 2), width: x1 - cx, height: CGFloat(a.r) * light)) }
+                if a.d > 0 { context.fill(CGRect(x: snap((x0 + x1) / 2 - CGFloat(a.d) * light / 2), y: y0, width: CGFloat(a.d) * light, height: cy + hl - y0)) }
+                if a.u > 0 { context.fill(CGRect(x: snap((x0 + x1) / 2 - CGFloat(a.u) * light / 2), y: cy, width: CGFloat(a.u) * light, height: y1 - cy)) }
+            }
+            context.restoreGState()
+        }
+    }
+}
+#endif
