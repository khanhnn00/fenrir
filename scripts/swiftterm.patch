+    /// URL under the mouse plus the columns it covers on the hovered screen row (for the hover underline).
+    func plainURLMatch (for event: NSEvent) -> (url: String, screenRow: Int, startCol: Int, endCol: Int)? {
+        let hit = calculateMouseHit(with: event).grid
+        let lines = terminal.buffer.lines
+        let row = terminal.buffer.yDisp + hit.row
+        guard row >= 0 && row < lines.count else { return nil }
+        var first = row
+        while first > 0 && lines[first].isWrapped { first -= 1 }
+        var last = row
+        while last + 1 < lines.count && lines[last + 1].isWrapped { last += 1 }
+        let cols = terminal.cols
+        // Each row is padded to the full width with spaces so offsets stay column-aligned and empty cells never leak NULs.
+        var text = ""
+        for i in first...last {
+            var s = lines[i].translateToString().replacingOccurrences(of: "\u{0}", with: " ")
+            let len = (s as NSString).length
+            if len < cols { s += String(repeating: " ", count: cols - len) }
+            text += s
+        }
+        let rowStart = (row - first) * cols
+        let offset = rowStart + hit.col
+        guard let regex = try? NSRegularExpression(pattern: #"https?://[^\s<>"'`]+"#) else { return nil }
+        let ns = text as NSString
+        for m in regex.matches(in: text, range: NSRange(location: 0, length: ns.length)) where NSLocationInRange(offset, m.range) {
